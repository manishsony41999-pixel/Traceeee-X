# Environment Configuration for TRACE-X Backend
# Copy this file to .env and configure with your actual values
# NEVER commit .env to version control

# ==============================================
# APPLICATION SETTINGS
# ==============================================
APP_NAME=TRACE-X
APP_VERSION=1.0.0
DEBUG=false

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
# PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://tracex:tracex_password@localhost:5432/tracex_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ==============================================
# REDIS CONFIGURATION (for caching & background jobs)
# ==============================================
REDIS_URL=redis://localhost:6379/0

# ==============================================
# SECURITY
# ==============================================
# Generate a strong random secret key for JWT tokens
# Example: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_IN_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ==============================================
# AI PROVIDER CONFIGURATION
# ==============================================
# Supported providers: openai, anthropic, demo
AI_PROVIDER=openai
AI_API_KEY=sk-your-openai-api-key-here
AI_MODEL=gpt-4
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.3

# Alternative: Anthropic Claude
# AI_PROVIDER=anthropic
# AI_API_KEY=sk-ant-your-anthropic-key-here
# AI_MODEL=claude-3-opus-20240229

# ==============================================
# THREAT INTELLIGENCE PROVIDERS
# ==============================================
# VirusTotal API v3
# Get your API key from: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# AbuseIPDB API v2
# Get your API key from: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# URLScan.io API (optional)
URLSCAN_API_KEY=

# IP Geolocation Provider (optional, falls back to free IP-API)
IP_GEOLOCATION_API_KEY=

# ==============================================
# INTELLIGENCE FALLBACK MODE
# ==============================================
# When true, uses demo/mock intelligence if external APIs unavailable
USE_DEMO_INTELLIGENCE=true

# ==============================================
# FILE UPLOAD LIMITS
# ==============================================
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_EXTENSIONS=[".eml",".msg",".txt"]

# ==============================================
# EMAIL ANALYSIS LIMITS
# ==============================================
MAX_URLS_PER_EMAIL=100
MAX_ATTACHMENTS_PER_EMAIL=20

# Suspicious TLDs (JSON array format)
SUSPICIOUS_TLDS=[".tk",".ml",".ga",".cf",".gq",".zip",".review"]

# Suspicious file extensions (JSON array format)
SUSPICIOUS_EXTENSIONS=[".exe",".scr",".bat",".cmd",".com",".pif",".js",".vbs",".ps1",".jar",".app",".docm",".xlsm",".pptm"]

# ==============================================
# RATE LIMITING
# ==============================================
RATE_LIMIT_PER_MINUTE=60

# ==============================================
# CORS ORIGINS (Frontend URLs)
# ==============================================
# JSON array format - add your frontend domains
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# ==============================================
# GOOGLE WORKSPACE & GMAIL REAL-TIME INGESTION
# ==============================================
# Google Cloud Pub/Sub Topic for Gmail push notifications
# Format: projects/{project_id}/topics/{topic_name}
GOOGLE_PUBSUB_TOPIC=projects/tracex-demo/topics/gmail-inbox-watch
GOOGLE_PUBSUB_SUBSCRIPTION=
GOOGLE_PUBSUB_VERIFICATION_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SERVICE_ACCOUNT_INFO=
GMAIL_WATCH_USERS=["security-demo@company.com"]
GMAIL_WATCH_RENEWAL_INTERVAL_HOURS=24
GMAIL_WATCH_LABEL_IDS=["INBOX"]

